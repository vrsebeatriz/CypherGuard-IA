    "id": "tp-command-injection",
    "check_id": "javascript.lang.security.audit.command-injection",
    "message": "Entrada do usuário chega ao exec() sem sanitização.",
    "code": "const host = req.query.host;\nexec(\"ping -c 1 \" + host, (err, stdout) => { res.send(stdout); });",
    "expected": "True Positive"
  },
  {
    "id": "tp-sql-injection",
